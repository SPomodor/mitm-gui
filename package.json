{
  "name": "mitm-gui",
  "version": "0.9.6",
  "description": "A desktop mitmproxy GUI for HTTP(S), WireGuard, rewrite rules and Python scripts",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "concurrently -k \"vite\" \"wait-on http://127.0.0.1:5173 && electron .\"",
    "build": "tsc --noEmit && vite build",
    "build:engine": "node scripts/build-engine.cjs",
    "package": "npm run build && npm run build:engine && electron-builder --win portable --publish never",
    "test": "node scripts/test-backend.cjs",
    "test:format": "node --experimental-strip-types --test tests/format-body.test.mts",
    "setup": "node scripts/setup.cjs",
    "package:mac": "npm run build && npm run build:engine && electron-builder --mac --publish never",
    "test:ui": "node --test tests/script-library.test.cjs tests/i18n.test.mjs",
    "test:smoke": "node scripts/smoke-ui.cjs --packaged",
    "test:language": "node scripts/smoke-language.cjs",
    "test:architecture": "node scripts/check-desktop-package.cjs"
  },
  "keywords": [],
  "author": "SPomodor",
  "license": "ISC",
  "type": "commonjs",
  "build": {
    "appId": "dev.spomodor.mitm-gui",
    "productName": "mitm gui",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json",
      "LICENSE",
      "NOTICE"
    ],
    "extraResources": [
      {
        "from": "examples/basic",
        "to": "examples"
      },
      {
        "from": "runtime/mitm-gui-engine",
        "to": "backend"
      }
    ],
    "win": {
      "target": [
        "portable"
      ],
      "signExecutable": false
    },
    "portable": {
      "artifactName": "mitm-gui-${version}-win-${arch}.exe"
    },
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "category": "public.app-category.developer-tools",
      "artifactName": "mitm-gui-${version}-mac-${arch}.${ext}",
      "minimumSystemVersion": "14.0",
      "hardenedRuntime": true,
      "entitlements": "resources/macos.entitlements.plist",
      "entitlementsInherit": "resources/macos.entitlements.plist",
      "notarize": false
    },
    "copyright": "Copyright © 2026 SPomodor",
    "beforePack": "scripts/before-pack.cjs",
    "afterSign": "scripts/notarize.cjs",
    "afterPack": "scripts/sign-unsigned-mac.cjs"
  },
  "dependencies": {
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-python": "^6.2.1",
    "@codemirror/language": "^6.13.1",
    "@codemirror/search": "^6.7.2",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.15",
    "@lezer/highlight": "^1.2.5",
    "@tanstack/react-virtual": "^3.14.20",
    "lucide-react": "^1.57.0",
    "qrcode.react": "^4.2.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "ws": "^8.22.0",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "concurrently": "^10.0.6",
    "electron": "^44.7.2",
    "electron-builder": "^26.15.3",
    "prettier": "^3.9.10",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "wait-on": "^9.5.1"
  },
  "homepage": "https://github.com/SPomodor/mitm-gui",
  "repository": {
    "type": "git",
    "url": "https://github.com/SPomodor/mitm-gui.git"
  },
  "bugs": {
    "url": "https://github.com/SPomodor/mitm-gui/issues"
  },
  "engines": {
    "node": ">=24 <25"
  }
}
