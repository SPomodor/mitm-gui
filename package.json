{
  "name": "chls",
  "version": "0.3.0",
  "description": "Desktop HTTP and WireGuard debugging proxy",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "concurrently -k \"vite\" \"wait-on http://127.0.0.1:5173 && electron .\"",
    "build": "tsc --noEmit && vite build",
    "build:engine": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/build-engine.ps1",
    "package": "npm run build && npm run build:engine && electron-builder --win portable",
    "test": ".venv\\Scripts\\python.exe -m pytest tests -q"
  },
  "keywords": [],
  "author": "CHLS",
  "license": "ISC",
  "type": "commonjs",
  "build": {
    "appId": "dev.chls.desktop",
    "productName": "CHLS",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "examples",
        "to": "examples"
      },
      {
        "from": "runtime/chls-engine",
        "to": "backend"
      }
    ],
    "win": {
      "target": [
        "portable"
      ],
      "signAndEditExecutable": false
    },
    "portable": {
      "artifactName": "CHLS-${version}.exe"
    }
  },
  "dependencies": {
    "@tanstack/react-virtual": "^3.14.20",
    "lucide-react": "^1.57.0",
    "qrcode.react": "^4.2.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "ws": "^8.22.0",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "concurrently": "^10.0.6",
    "electron": "^44.7.2",
    "electron-builder": "^26.15.3",
    "prettier": "^3.9.10",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "wait-on": "^9.5.1"
  }
}
